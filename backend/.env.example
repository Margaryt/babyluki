# Local development (used by docker-compose and the app)
POSTGRES_USER=babyluki
POSTGRES_PASSWORD=babyluki
POSTGRES_DB=babyluki

# Prisma database connection
# Local: postgresql://babyluki:babyluki@localhost:5432/babyluki?schema=public
# Railway: auto-injected by the PostgreSQL plugin, no need to set manually
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
